#!/bin/sh
# Batteries of mice, keyboards and other peripherals.
#   peripheral-battery      i3status-rust custom-block JSON: shown only when one
#                           is at or below WARN; empty text (block hidden)
#                           otherwise, or when none is connected / answering
#   peripheral-battery -l   every peripheral and its percentage, one per line
# Sources:
#   Keychron M3 (USB or Keychron Link): ~/bin/keychron-battery (UPower can't see it)
#   anything UPower lists that isn't a power supply (e.g. the K3 over Bluetooth)
#   HID batteries UPower doesn't list (e.g. the K2 over Bluetooth): the kernel's
#     capacity if it has one, else ~/bin/hid-battery asks the device
# Only keychron-battery reports charging; UPower's state for HID batteries
# is a guess, so it is not shown.
WARN=${WARN:-50}   # % at or below: shown, Warning
CRIT=${CRIT:-15}   # % at or below: Critical
PS=${PS:-/sys/class/power_supply}

case ${1-} in
    '') list=0 ;;
    -l|--list) list=1 ;;
    *) sed -n '2,6p' "$0" | sed 's/^# \{0,1\}//' >&2; exit 2 ;;
esac

items='' state=''
report() {   # report ICON PERCENT NAME [STATUS]
    if [ "$list" = 1 ]; then
        printf '%-16s %3s%%%s\n' "$3" "$2" "${4:+ ($4)}"
        return
    fi
    [ "$2" -le "$WARN" ] || return 0
    [ "${4-}" = charging ] && chg='⚡' || chg=''
    items="$items${items:+  }$1 $chg$2%"
    if [ "$2" -le "$CRIT" ]; then state=Critical
    elif [ "$state" != Critical ]; then state=Warning; fi
}

fix_pct() {   # fix_pct MODEL PERCENT: undo known misreports
    case $1 in
        # declares its battery as 0-255 but sends 0-100: full reads as 39 %
        'Keychron K3') set -- "$1" $(( ($2 * 255 + 50) / 100 )); [ "$2" -le 100 ] || set -- "$1" 100 ;;
    esac
    echo "$2"
}
icon_for() {   # icon_for KIND MODEL
    case $1 in
        keyboard) echo '󰌌' ;;
        mouse)    echo '󰍽' ;;
        *)        echo "${2:-$1}" ;;
    esac
}

if out=$("$HOME/bin/keychron-battery" 2>/dev/null); then
    case $out in *'(charging)'*) st=charging ;; *'(full)'*) st=full ;; *) st='' ;; esac
    report '󰍽' "${out%%%*}" 'Keychron M3' "$st"
fi

seen=' '   # native paths UPower reported, so the sysfs loop skips them
for dev in $(upower -e 2>/dev/null); do
    info=$(upower -i "$dev") || continue
    printf '%s\n' "$info" | grep -q '^ *power supply: *no$' || continue
    printf '%s\n' "$info" | grep -q '^ *present: *no$' && continue
    # "NN%" only; "(should be ignored)" percentages don't match
    pct=$(printf '%s\n' "$info" | sed -n 's/^ *percentage: *\([0-9]*\)\(\.[0-9]*\)\{0,1\}%$/\1/p')
    [ -n "$pct" ] || continue
    kind=$(printf '%s\n' "$info" | sed -n 's/^  \([a-z-]*\)$/\1/p' | head -n 1)
    model=$(printf '%s\n' "$info" | sed -n 's/^ *model: *//p' | tr -d '"\\')
    seen="$seen$(printf '%s\n' "$info" | sed -n 's/^ *native-path: *//p') "
    report "$(icon_for "$kind" "$model")" "$(fix_pct "$model" "$pct")" "${model:-$kind}"
done

# HID batteries UPower doesn't list. It can miss one for good: the K2 over
# Bluetooth has no value when it connects (the kernel's Apple quirk asks it for
# a feature report it doesn't have), and UPower doesn't look again once the K2
# later sends one. Use the kernel's capacity if readable, else ask the device.
for ps in "$PS"/hid-*-battery*; do
    [ -e "$ps" ] || continue
    case $seen in *" ${ps##*/} "*) continue ;; esac
    model=$(tr -d '"\\' < "$ps/model_name" 2>/dev/null)
    if pct=$(cat "$ps/capacity" 2>/dev/null) && [ -n "$pct" ]; then
        kind=$("$HOME/bin/hid-battery" -k "$ps" 2>/dev/null) || kind=device
    else
        out=$("$HOME/bin/hid-battery" "$ps" 2>/dev/null) || continue
        pct=${out%% *} kind=${out#* }
    fi
    report "$(icon_for "$kind" "$model")" "$(fix_pct "$model" "$pct")" "${model:-$kind}"
done

[ "$list" = 1 ] && exit 0
if [ -z "$items" ]; then
    echo '{"text":""}'
else
    printf '{"text":"%s","state":"%s"}\n' "$items" "$state"
fi
