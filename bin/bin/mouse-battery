#!/bin/sh
# Bar block: wireless mouse battery, shown only when low.
# Prints i3status-rust custom-block JSON; empty text (block hidden) above WARN,
# or when no supported mouse is connected or it doesn't answer (asleep).
# Mice: Keychron M3 (keychron-battery).
WARN=${WARN:-50}   # % at or below: shown, Warning
CRIT=${CRIT:-15}   # % at or below: Critical

out=$("$HOME/bin/keychron-battery" 2>/dev/null) || { echo '{"text":""}'; exit 0; }
pct=${out%%%*}
case $out in *charging*) chg='⚡' ;; *) chg='' ;; esac

if [ "$pct" -le "$CRIT" ]; then
    state=Critical
elif [ "$pct" -le "$WARN" ]; then
    state=Warning
else
    echo '{"text":""}'
    exit 0
fi
printf '{"text":"󰍽 %s%s%%","state":"%s"}\n' "$chg" "$pct" "$state"
