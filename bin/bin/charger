#!/bin/sh
# Bar block: USB-C charger power, coloured by whether it is enough.
# Prints i3status-rust custom-block JSON; empty text (block hidden) without a
# USB-C charger, so it also stays hidden on machines that have none.
# Shows only the symbol and colour; `charger toggle` (bound to clicks) flips
# between that and also showing the wattage.
FULL=60   # W this laptop can draw; at or above: full power (green)
MIN=30    # W below which a charger is too weak to be useful (red)
PS=${PS:-/sys/class/power_supply}
FLAG=${XDG_RUNTIME_DIR:-/tmp}/charger-watts   # exists: show the wattage

if [ "$1" = toggle ]; then
    if [ -e "$FLAG" ]; then rm -f "$FLAG"; else : > "$FLAG"; fi
    exit
fi

w=0
for d in "$PS"/ucsi-source-psy-*; do
    [ "$(cat "$d/online" 2>/dev/null)" = 1 ] || continue
    p=$(( $(cat "$d/voltage_now") / 1000 * ($(cat "$d/current_max") / 1000) / 1000000 ))
    [ "$p" -gt "$w" ] && w=$p
done

watts=""
[ -e "$FLAG" ] && watts="${w}W"

if [ "$w" -eq 0 ]; then
    echo '{"text":""}'
elif [ "$(cat "$PS/BAT0/status" 2>/dev/null)" = Discharging ]; then
    printf '{"text":"⚠%s","state":"Critical"}\n' "${watts:+ $watts}"
elif [ "$w" -lt "$MIN" ]; then
    printf '{"text":"⚡%s","state":"Critical"}\n' "$watts"
elif [ "$w" -lt "$FULL" ]; then
    printf '{"text":"⚡%s","state":"Warning"}\n' "$watts"
else
    printf '{"text":"⚡%s","state":"Good"}\n' "$watts"
fi
