[user]
	email = luisggpina@users.noreply.github.com
	name = Luís Pina
[core]
    editor = vim
    quotepath = false
[init]
    defaultBranch = main
[pull]
    ff = only
[push]
    autoSetupRemote = true
[diff]
    tool = vimdiff
    algorithm = histogram
[difftool]
    prompt = false
[merge]
    tool = vimdiff
    conflictStyle = zdiff3
[mergetool]
    keepBackup = false
[alias]
    follow = log --follow
[include]
    path = ~/.gitconfig.local
